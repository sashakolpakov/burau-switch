  "resource_scaling": {
    "parallel_generic_minimum_bank": "d+1 settings and d(d+1) detectors; d+1 independently instantiated universal meshes contain (d+1)d(d-1)/2 generic two-mode cells, while specializing the computational-basis branch as a direct detector path reduces this to d^2(d-1)/2",
    "structured_mub_opportunity": "the odd-prime chirp bases factor into a Fourier transform and basis-dependent diagonal phases, so a specialized implementation need not pay the independent-generic-mesh cell count",
    "task_specific_spectral": "one generic d-mode unitary, d detectors, d(d-1)/2 generic two-mode cells, and O(d) path depth",
    "time_multiplexed_generic_minimum_bank": "one reusable O(d^2)-cell universal mesh and d detectors, at the cost of d+1 sequential settings and mesh reprogramming"
